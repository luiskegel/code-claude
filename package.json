{
  "name": "claude-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Claude Academy – interaktive Lernplattform, die Claude von null an erklärt.",
  "scripts": {
    "dev": "vite",
    "gen:meta": "node --experimental-strip-types scripts/generate-meta.mjs",
    "prebuild": "npm run gen:meta",
    "build": "vite build",
    "build:artifact": "node scripts/build-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run gen:meta && npm run typecheck && npm run build && npm run test:content",
    "test:content": "node --experimental-strip-types scripts/check-content.mjs",
    "test:browser": "node --experimental-strip-types scripts/check-browser.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
