# Kopiere diese Datei nach server/.env und trage deinen eigenen Schlüssel ein.
# server/.env ist in .gitignore eingetragen und wird NIE ins Repository übernommen.
ALPHA_VANTAGE_API_KEY=
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
CACHE_SECONDS=300
# Währung der Kurse ist vom Börsenplatz abhängig (z. B. EUR bei .DE-Symbolen)
QUOTE_CURRENCY=lokal
