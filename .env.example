# Kopiere diese Datei zu ".env" und trage EINEN Anbieter ein.
#
# WICHTIG: .env wird von .gitignore ausgeschlossen und darf niemals committet
# werden. Die Schlüssel werden ausschliesslich im Node-Server (server/) gelesen,
# niemals im Browser-Code unter public/.
#
# Ein API-Schlüssel ist NICHT dein Passwort: Du erzeugst ihn selbst beim
# Anbieter und kannst ihn dort jederzeit widerrufen.

# Welcher Anbieter genutzt wird: openai | gemini | anthropic | mock
# Ohne Angabe wird der erste Anbieter genommen, für den ein Schlüssel gesetzt ist.
AI_PROVIDER=openai


# --- ChatGPT (OpenAI) ------------------------------------------------------
# Schlüssel erzeugen: https://platform.openai.com/api-keys
# Achtung: Die API wird getrennt abgerechnet – ein ChatGPT-Plus-Abo deckt sie nicht ab.
OPENAI_API_KEY=

# --- Gemini (Google) -------------------------------------------------------
# Schlüssel erzeugen: https://aistudio.google.com/apikey
# Es gibt ein kostenloses Kontingent mit Tageslimit.
GOOGLE_API_KEY=

# --- Claude (Anthropic) ----------------------------------------------------
# Schlüssel erzeugen: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# Optionales Modell-Override. Ohne Angabe gilt je Anbieter:
#   openai    -> gpt-4o
#   gemini    -> gemini-2.0-flash
#   anthropic -> claude-sonnet-5
AI_MODEL=

# Port des lokalen Servers
PORT=3000
