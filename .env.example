# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# WICHTIG: .env wird von .gitignore ausgeschlossen und darf niemals committet werden.
# Der Schlüssel wird ausschliesslich im Node-Server (server/) gelesen,
# niemals im Browser-Code unter public/.

# Welcher Anbieter genutzt wird: "mock" (ohne Schlüssel) oder "anthropic"
AI_PROVIDER=mock

# API-Schlüssel – nur nötig, wenn AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optionales Modell-Override
AI_MODEL=claude-sonnet-5

# Port des lokalen Servers
PORT=3000
